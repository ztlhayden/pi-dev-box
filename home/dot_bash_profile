# Login shells read this instead of ~/.profile, so hand over to it below.

# Shims put mise-managed tools on PATH for programs that never run an interactive
# shell (VS Code server, Claude Code).
eval "$(mise activate bash --shims)"

# npm skips dependencies' install scripts unless one is run on purpose, as pnpm does.
# Set here rather than in ~/.npmrc, which is per machine and not managed by this repo.
export npm_config_ignore_scripts=true

[ -f ~/.profile ] && . ~/.profile
